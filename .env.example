# demo o firebase. No se conecta a Firebase en demo.
VITE_DATA_MODE=demo
# Sin + ni espacios; vacío mantiene WhatsApp desactivado.
VITE_WHATSAPP_NUMBER=
# Código ISO 4217, p. ej. la moneda REAL acordada con EP 3D. Vacío bloquea compra real.
VITE_CURRENCY=
# Configuración pública de la app web Firebase (no es una cuenta de servicio).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
