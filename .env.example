# demo o firebase. No se conecta a Firebase en demo.
VITE_DATA_MODE=demo
# Fotos desactivadas hasta habilitar Storage con el propietario.
VITE_STORAGE_ENABLED=false
# Sin + ni espacios; vacío mantiene WhatsApp desactivado.
VITE_WHATSAPP_NUMBER=
# Moneda confirmada por Rubén. Precios en centavos de USD.
VITE_CURRENCY=USD
# Configuración pública de la app web Firebase (no es una cuenta de servicio).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
