rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /products/{productId}/{fileName} {
      // Solo fotos públicas de catálogo, nunca datos privados.
      allow read: if true;
      allow create, update: if admin()
        && productId.matches('[a-zA-Z0-9_-]{1,128}')
        && fileName.matches('[a-zA-Z0-9_-]+[.]webp')
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
